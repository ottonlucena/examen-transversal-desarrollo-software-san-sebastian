meta {
  name: 17 Actualizar álbum (200)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/albumes/{{albumId}}
  body: json
  auth: none
}

headers {
  X-Usuario: bruno
}

body:json {
  {
    "nombre": "Qatar 2022",
    "imagen": "https://ejemplo.cl/qatar-2022.png",
    "fechaLanzamiento": "2022-08-24",
    "tipoLaminas": "ADHESIVA",
    "totalLaminas": 20,
    "editorial": "Panini",
    "descripcion": "Descripción actualizada"
  }
}

tests {
  test("200 y modificadoPor actualizado", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.descripcion).to.equal("Descripción actualizada");
    expect(res.body.auditoria.modificadoPor).to.equal("bruno");
  });
}
