meta {
  name: 13 Validación de datos (400)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/albumes
  body: json
  auth: none
}

body:json {
  {
    "nombre": " ",
    "imagen": "no-es-una-url",
    "fechaLanzamiento": "2999-01-01",
    "tipoLaminas": "ADHESIVA",
    "totalLaminas": 0
  }
}

tests {
  test("400 con errores por campo", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.body.errores).to.have.all.keys("nombre", "imagen", "fechaLanzamiento", "totalLaminas");
  });
}
