meta {
  name: 15 Listar álbumes paginado (200)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/albumes?page=0&size=5&sort=nombre
  body: none
  auth: none
}

params:query {
  page: 0
  size: 5
  sort: nombre
}

tests {
  test("200 con content y metadatos de página", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.content).to.be.an("array");
    expect(res.body.page).to.have.all.keys("size", "number", "totalElements", "totalPages");
  });
}
