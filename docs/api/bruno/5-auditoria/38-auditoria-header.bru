meta {
  name: 38 Auditoría con X-Usuario (200)
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/albumes/{{albumId}}
  body: json
  auth: none
}

headers {
  X-Usuario: ana
}

body:json {
  {
    "nombre": "Qatar 2022",
    "imagen": "https://ejemplo.cl/qatar-2022.png",
    "fechaLanzamiento": "2022-08-24",
    "tipoLaminas": "ADHESIVA",
    "totalLaminas": 20,
    "editorial": "Panini",
    "descripcion": "Revisado por ana"
  }
}

tests {
  test("creadoPor se conserva y modificadoPor toma el header", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.auditoria.creadoPor).to.equal("equipo");
    expect(res.body.auditoria.modificadoPor).to.equal("ana");
  });
}
