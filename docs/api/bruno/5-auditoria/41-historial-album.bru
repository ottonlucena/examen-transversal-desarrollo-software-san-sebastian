meta {
  name: 41 Historial de álbum eliminado (200)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/albumes/{{albumId}}/historial
  body: none
  auth: none
}

tests {
  test("200 con todas las revisiones hasta la eliminación", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.map((r) => r.operacion)).to.eql(["CREACION", "MODIFICACION", "MODIFICACION", "ELIMINACION"]);
    expect(res.body[res.body.length - 1].usuario).to.equal("diego");
  });
}
