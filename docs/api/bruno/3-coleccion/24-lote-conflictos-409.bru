meta {
  name: 24 Lote con conflictos (409)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/albumes/{{albumId}}/laminas/lote
  body: json
  auth: none
}

body:json {
  {
    "laminas": [
      { "numero": 10, "nombre": "Ya existe", "tipo": "NORMAL" },
      { "numero": 25, "nombre": "Fuera de rango", "tipo": "NORMAL" },
      { "numero": 11, "nombre": "Válida", "tipo": "NORMAL" }
    ]
  }
}

tests {
  test("409 informa cada posición con problema y no crea ninguna", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.body.errores).to.have.all.keys("laminas[0].numero", "laminas[1].numero");
  });
}
