meta {
  name: 28 Restar una copia (200)
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/laminas/{{lamina3Id}}/cantidad
  body: json
  auth: none
}

headers {
  X-Usuario: equipo
}

body:json {
  {
    "delta": -1
  }
}

tests {
  test("200 la lámina 3 pasa de 3 a 2 copias", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.cantidad).to.equal(2);
    expect(res.body.repetidas).to.equal(1);
  });
}
