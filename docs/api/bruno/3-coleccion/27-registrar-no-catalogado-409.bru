meta {
  name: 27 Registrar número no catalogado (409)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/albumes/{{albumId}}/laminas/registrar
  body: json
  auth: none
}

body:json {
  {
    "numeros": [1, 99]
  }
}

tests {
  test("409 y no se registra ninguna copia", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.body.errores.numeros).to.contain("99");
  });
}
