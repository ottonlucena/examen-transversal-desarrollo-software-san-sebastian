meta {
  name: 31 Láminas repetidas (200)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/albumes/{{albumId}}/laminas/repetidas
  body: none
  auth: none
}

tests {
  test("200 con la cantidad de repetidas de cada lámina", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.laminas.map((l) => [l.numero, l.repetidas])).to.eql([[2, 1], [3, 1]]);
    expect(res.body.laminasRepetidas).to.equal(2);
    expect(res.body.totalCopiasRepetidas).to.equal(2);
  });
}
