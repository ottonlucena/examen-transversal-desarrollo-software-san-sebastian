meta {
  name: 26 Registrar obtenidas (200)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/albumes/{{albumId}}/laminas/registrar
  body: json
  auth: none
}

headers {
  X-Usuario: equipo
}

body:json {
  {
    "numeros": [1, 2, 2, 3, 3, 3]
  }
}

tests {
  test("200 suma una copia por aparición", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.copiasRegistradas).to.equal(6);
    expect(res.body.laminas.map((l) => l.cantidad)).to.eql([1, 2, 3]);
  });
}
