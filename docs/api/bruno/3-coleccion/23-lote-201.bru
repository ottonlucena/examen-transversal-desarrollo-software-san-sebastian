meta {
  name: 23 Carga en lote (201)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/albumes/{{albumId}}/laminas/lote
  body: json
  auth: none
}

headers {
  X-Usuario: equipo
}

body:json {
  {
    "laminas": [
      { "numero": 1, "nombre": "Trofeo", "tipo": "ESPECIAL" },
      { "numero": 2, "nombre": "Balón oficial", "tipo": "ESPECIAL" },
      { "numero": 3, "nombre": "Mascota oficial", "tipo": "BRILLANTE" },
      { "numero": 4, "nombre": "Escudo Argentina", "tipo": "ESCUDO" },
      { "numero": 5, "nombre": "Escudo Francia", "tipo": "ESCUDO" },
      { "numero": 6, "nombre": "Escudo Croacia", "tipo": "ESCUDO" },
      { "numero": 7, "nombre": "Escudo Marruecos", "tipo": "ESCUDO" },
      { "numero": 8, "nombre": "Estadio Lusail", "tipo": "NORMAL" },
      { "numero": 9, "nombre": "Plantel Argentina", "tipo": "NORMAL" },
      { "numero": 10, "nombre": "Plantel Francia", "tipo": "NORMAL" }
    ]
  }
}

script:post-response {
  const idDe = (numero) => res.body.find((l) => l.numero === numero).id;
  bru.setVar("lamina2Id", idDe(2));
  bru.setVar("lamina3Id", idDe(3));
  bru.setVar("lamina4Id", idDe(4));
}

tests {
  test("201 con las 10 láminas creadas", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.body).to.have.lengthOf(10);
  });
}
