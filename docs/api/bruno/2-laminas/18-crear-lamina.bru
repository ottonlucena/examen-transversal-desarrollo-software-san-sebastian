meta {
  name: 18 Crear lámina (201)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/albumes/{{albumId}}/laminas
  body: json
  auth: none
}

headers {
  X-Usuario: equipo
}

body:json {
  {
    "numero": 20,
    "nombre": "Lámina de prueba",
    "tipo": "NORMAL"
  }
}

script:post-response {
  bru.setVar("laminaPruebaId", res.body.id);
}

tests {
  test("201 y lámina FALTANTE (cantidad 0)", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.estado).to.equal("FALTANTE");
  });
}
