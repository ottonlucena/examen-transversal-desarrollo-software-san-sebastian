meta {
  name: 20 Listar láminas por tipo (200)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/albumes/{{albumId}}/laminas?tipo=NORMAL
  body: none
  auth: none
}

params:query {
  tipo: NORMAL
}

tests {
  test("200 y solo láminas del tipo pedido", function() {
    expect(res.getStatus()).to.equal(200);
    res.body.forEach(function(l) { expect(l.tipo).to.equal("NORMAL"); });
  });
}
