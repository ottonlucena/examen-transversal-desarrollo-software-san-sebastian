meta {
  name: 35 Archivo que no es imagen (415)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/laminas/{{lamina3Id}}/foto
  body: multipartForm
  auth: none
}

body:multipart-form {
  archivo: @file(archivos/falsa.png)
}

tests {
  test("415 aunque la extensión sea .png", function() {
    expect(res.getStatus()).to.equal(415);
  });
}
