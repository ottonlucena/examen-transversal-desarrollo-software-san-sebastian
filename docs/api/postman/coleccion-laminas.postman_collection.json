{
  "info": {
    "name": "Colección de Láminas API",
    "description": "Examen Transversal · Desarrollo de Software Web II · Grupo 2 (Valeria Gómez y Otton Lucena).\nRequests numeradas 12 a 41 como las capturas del informe. Ejecutar en orden sobre una base recién creada: cada request usa ids que guardan las anteriores en las variables de la colección.\nLas fotos (33, 35 y 36) usan archivos de docs/api/postman/archivos: en Postman, Settings > General > Working directory = carpeta docs/api/postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Álbumes",
      "item": [
        {
          "name": "12 Crear álbum (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Usuario",
                "value": "equipo"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/albumes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "albumes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Qatar 2022\",\n  \"imagen\": \"https://ejemplo.cl/qatar-2022.png\",\n  \"fechaLanzamiento\": \"2022-08-24\",\n  \"tipoLaminas\": \"ADHESIVA\",\n  \"totalLaminas\": 20,\n  \"editorial\": \"Panini\",\n  \"descripcion\": \"Álbum creado desde Bruno\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"albumId\", pm.response.json().id);",
                  "pm.test(\"201 Created con header Location\", function() {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "  pm.expect(pm.response.headers.get(\"location\")).to.contain(\"/api/albumes/\" + pm.response.json().id);",
                  "});",
                  "pm.test(\"auditoría registra al usuario del header\", function() {",
                  "  pm.expect(pm.response.json().auditoria.creadoPor).to.equal(\"equipo\");",
                  "});"
                ]
              }
            }
          ]
        },
