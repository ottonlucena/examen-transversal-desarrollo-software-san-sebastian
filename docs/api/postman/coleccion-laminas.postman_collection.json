            "body": {
              "mode": "raw",
              "raw": "{\n  \"laminas\": [\n    { \"numero\": 1, \"nombre\": \"Trofeo\", \"tipo\": \"ESPECIAL\" },\n    { \"numero\": 2, \"nombre\": \"Balón oficial\", \"tipo\": \"ESPECIAL\" },\n    { \"numero\": 3, \"nombre\": \"Mascota oficial\", \"tipo\": \"BRILLANTE\" },\n    { \"numero\": 4, \"nombre\": \"Escudo Argentina\", \"tipo\": \"ESCUDO\" },\n    { \"numero\": 5, \"nombre\": \"Escudo Francia\", \"tipo\": \"ESCUDO\" },\n    { \"numero\": 6, \"nombre\": \"Escudo Croacia\", \"tipo\": \"ESCUDO\" },\n    { \"numero\": 7, \"nombre\": \"Escudo Marruecos\", \"tipo\": \"ESCUDO\" },\n    { \"numero\": 8, \"nombre\": \"Estadio Lusail\", \"tipo\": \"NORMAL\" },\n    { \"numero\": 9, \"nombre\": \"Plantel Argentina\", \"tipo\": \"NORMAL\" },\n    { \"numero\": 10, \"nombre\": \"Plantel Francia\", \"tipo\": \"NORMAL\" }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
