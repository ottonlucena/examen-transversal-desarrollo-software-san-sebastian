          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const idDe = (numero) => pm.response.json().find((l) => l.numero === numero).id;",
                  "pm.collectionVariables.set(\"lamina2Id\", idDe(2));",
                  "pm.collectionVariables.set(\"lamina3Id\", idDe(3));",
                  "pm.collectionVariables.set(\"lamina4Id\", idDe(4));",
                  "pm.test(\"201 con las 10 láminas creadas\", function() {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "  pm.expect(pm.response.json()).to.have.lengthOf(10);",
                  "});"
                ]
              }
            }
          ]
